{
  "project_name": "solo-0028-dual-end-echo-trace",
  "project_shape": "fullstack",
  "modules": [
    {
      "id": "contract",
      "path": "echotrace/contract.py",
      "responsibility": "JSON 与领域字段边界"
    },
    {
      "id": "domain",
      "path": "echotrace/domain.py",
      "responsibility": "解析领域单位与归约事实"
    },
    {
      "id": "rules",
      "path": "echotrace/rules.py",
      "responsibility": "消费归约证据和约束，产生业务判定"
    },
    {
      "id": "artifacts",
      "path": "echotrace/artifacts.py",
      "responsibility": "成果规范编码、摘要与差分"
    },
    {
      "id": "archive",
      "path": "echotrace/archive.py",
      "responsibility": "SQLite 历史版本与原子封存"
    },
    {
      "id": "service",
      "path": "echotrace/service.py",
      "responsibility": "串联归约、比对和历史读取"
    },
    {
      "id": "server",
      "path": "echotrace/server.py",
      "responsibility": "本机 HTTP 及静态界面入口"
    },
    {
      "id": "workbench",
      "path": "web/ui.js",
      "responsibility": "页面状态、样例归约、视图切换与图形编排"
    },
    {
      "id": "reconcile",
      "path": "echotrace/reconcile.py",
      "responsibility": "联合原始归约事实与业务判定，推导双端可见区"
    },
    {
      "id": "capture",
      "path": "echotrace/capture.py",
      "responsibility": "复核证据归约"
    },
    {
      "id": "review",
      "path": "echotrace/review.py",
      "responsibility": "编排按领域事实驱动的可选复核"
    },
    {
      "id": "closure_review",
      "path": "echotrace/closure_review.py",
      "responsibility": "复核证据归约"
    },
    {
      "id": "pulses",
      "path": "echotrace/pulses.py",
      "responsibility": "滑窗提取局部脉冲及邻点证据"
    },
    {
      "id": "propagation",
      "path": "echotrace/propagation.py",
      "responsibility": "端头时延、统一里程和采样窗口"
    },
    {
      "id": "pairing",
      "path": "echotrace/pairing.py",
      "responsibility": "双端同极候选与双向唯一闭合"
    },
    {
      "id": "result_table",
      "path": "web/result-table.js",
      "responsibility": "结果表及结构化证据明细"
    },
    {
      "id": "version_panel",
      "path": "web/version-panel.js",
      "responsibility": "封存选择、版本读取、比对和下载"
    }
  ],
  "workflows": [
    {
      "id": "wave",
      "name": "原始波形",
      "entry": "POST /echotrace/api/evaluate 的 outputs.wave",
      "steps": [
        "逐端严格校验时标与长度",
        "left/点1 的 时刻 为 40"
      ],
      "success": "left/点1 的 时刻 为 40",
      "failure": "非法领域数据返回 400；不产生伪造结果",
      "verification": "python3 -m echotrace.check_flow wave",
      "module_ids": [
        "server",
        "contract",
        "service",
        "domain",
        "rules",
        "artifacts",
        "result_table"
      ]
    },
    {
      "id": "peak",
      "name": "脉冲提取",
      "entry": "POST /echotrace/api/evaluate 的 outputs.peak",
      "steps": [
        "门限及左右邻点确定局部峰极性",
        "left/点1 的 状态 为 \"positive\""
